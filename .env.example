# Copy to .env and fill in the blanks:  cp .env.example .env
# Never commit .env. Used by docker compose, and by the API when you run it outside Docker.

# --- Database and Redis (these hostnames are for docker compose; outside Docker use localhost) ---
DATABASE_URL=postgresql+asyncpg://sift:sift@db:5432/sift
REDIS_URL=redis://redis:6379/0

# --- AI providers ---
# Set both providers to "mock" for the fixed, offline demo (no AI keys required).
LLM_PROVIDER=groq
TRANSCRIPTION_PROVIDER=groq

# Groq: transcription of uploaded audio and Llama note sorting
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Optional Anthropic note sorting
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional local Ollama note sorting. When running in Docker, use
# http://host.docker.internal:11434/v1 to reach Ollama on the host machine.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Login ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_DAYS=7
# Set to false once you have created your own account
ALLOW_SIGNUP=true

# --- Where the web app lives ---
# Exact address of the web app, no trailing slash. Used for the Google redirect and the WebSocket origin check.
FRONTEND_URL=http://localhost:3002
# Optional extra origins allowed to use the WebSocket and call the API directly (comma separated)
ALLOWED_ORIGINS=
# Where the BROWSER reaches the API for live captions (docker compose passes this to the web container)
WS_URL=ws://localhost:8002

# --- Local Whisper (live captions always use local Whisper) ---
# Uploaded recordings when TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=small
# Live captions: base keeps up on most CPUs, small is more accurate but needs a faster one
WHISPER_LIVE_MODEL=base
# Empty = auto-detect. Set en, hi, ... to lock the language
WHISPER_LANGUAGE=
# Load the live model at startup so the first session is not slow
WHISPER_PRELOAD=true
LIVE_MAX_SECONDS=300
LIVE_TICK_SECONDS=1.5

# --- Google Calendar (optional, see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorised redirect URI in Google Cloud. In production use your API address.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Timezone used when an event has none
DEFAULT_TZ=Asia/Kolkata

# --- Single-server production with Caddy only (see docs/DEPLOYMENT.md) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
